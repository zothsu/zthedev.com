---
import Layout from '../layouts/MainLayout.astro';

// TODO: restore the full homepage sections below once the rebuild is ready.
// import HeroSection from '../components/HeroSection.astro';
// import AboutSection from '../components/AboutSection.astro';
// import CertificationsSection from '../components/CertificationsSection.astro';
// import ProjectsSection from '../components/ProjectsSection.astro';
// import FaqSection from '../components/FaqSection.astro';
// import ContactSection from '../components/ContactSection.astro';
---

<Layout
  title="Z-theDev - Coming Soon"
  description="Z-theDev's site is being rebuilt. Check back soon."
  >
  <section
    id="hero"
    class="lg:min-h-screen pt-32 pb-24 flex items-center relative overflow-hidden cyber-grid"
  >
    <div class="absolute inset-0 bg-dark-space/30"></div>
    <div class="absolute top-0 left-0">
      <div class="absolute top-1/4 left-1/4 rounded-full bg-neon-purple/20 blur-3xl"></div>
      <div class="absolute bottom-1/3 right-1/4 rounded-full bg-neon-cyan/10 blur-3xl"></div>
    </div>

    <div class="mx-auto px-4 relative z-10 text-center max-w-4xl">
      <div class="font-code text-neon-cyan mb-6">
        <span class="inline-block border border-neon-cyan/50 px-3 py-1 rounded-full text-sm uppercase">
          Rebuilding
        </span>
      </div>
      <h1 class="text-5xl md:text-6xl xl:text-7xl font-bold tracking-wide mb-6">
        <span class="text-neon-cyan neon-text">Coming</span>
        <span class="text-neon-purple neon-purple-text">Soon</span>
      </h1>
      <p class="text-xl text-gray-300 mb-10 max-w-2xl mx-auto">
        Z-theDev is getting a refresh. In the meantime, find me here.
      </p>
      <div class="flex justify-center items-center gap-6">
        <a
          href="https://github.com/zothsu"
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
          class="text-gray-300 hover:text-neon-cyan transition duration-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2A10 10 0 002 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.68 0 0 .84-.27 2.75 1.02A9.564 9.564 0 0112 6.8c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0012 2z"></path>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/z-thedev/"
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn"
          class="text-gray-300 hover:text-neon-cyan transition duration-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24">
            <path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>