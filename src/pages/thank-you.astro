---
import Layout from "../layouts/PageLayout.astro";
import { Button } from "@/components/starwind/button";
---

<Layout title="Thank you | Z-theDev" description="Your message has been sent." noindex>
  <section class="relative flex flex-1 items-center justify-center overflow-hidden">
    <div class="absolute inset-0 cyber-grid opacity-20"></div>
    <div class="relative mx-auto w-full max-w-2xl px-4 py-24 text-center">
      <h1 class="font-heading text-3xl font-bold tracking-tight sm:text-5xl">
        Thank you!
      </h1>
      <p class="text-muted-foreground mx-auto mt-4 max-w-xl text-lg">
        Your message is on its way.<br />
        Expect a reply from me in one to three business days.
      </p>

      <div class="mt-8">
        <Button variant="primary" href="/">Back to my website</Button>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  /* Let the thank-you section fill the space between navbar and footer so its
     content centers vertically. Only emitted for this page. */
  main {
    display: flex;
    flex-direction: column;
  }
</style>
