---
import Logo from "./ui/Logo.astro";

export interface NavItemType {
  label: string;
  href: string;
  isButton?: boolean;
}

interface Props {
  navItems: NavItemType[];
  smooth?: boolean;
}

const { navItems, smooth = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header
  class="fixed top-0 inset-x-0 z-50 backdrop-blur-md bg-dark-space/80 border-b border-neon-cyan/30"
  x-data="{ navOpen: false }"
>
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex justify-between h-16">
      <Logo />

      <!-- Desktop Menu -->
      <nav class="hidden lg:flex items-center space-x-8">
        {navItems.map((item) => {
          const isActive = !smooth && currentPath === item.href;
          return (
            <a
              href={item.href}
              {...(smooth ? { "data-type": "smooth" } : {})}
              class:list={[
                "nav-link",
                item.isButton && "nav-link-button",
                isActive && "active",
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Mobile menu button -->
      <div class="lg:hidden flex items-center">
        <button
          @click="navOpen = !navOpen"
          class="text-neon-cyan focus:outline-none"
          aria-label="Toggle menu"
        >
          <svg
            x-show="!navOpen"
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
          <svg
            x-show="navOpen"
            x-cloak
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    x-show="navOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 scale-95"
    x-transition:enter-end="opacity-100 scale-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 scale-100"
    x-transition:leave-end="opacity-0 scale-95"
    class="lg:hidden bg-dark-space/95 backdrop-blur-md border-b border-neon-cyan/30"
    x-cloak
  >
    <div class="max-w-7xl mx-auto px-4 space-y-1 pb-6">
      {navItems.map((item) => {
        const isActive = !smooth && currentPath === item.href;
        return (
          <a
            href={item.href}
            {...(smooth ? { "data-type": "smooth" } : {})}
            x-on:click="navOpen = false"
            class:list={[
              "nav-link-mobile",
              item.isButton && "nav-link-mobile-button",
              isActive && "active",
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </div>
  </div>
</header>
