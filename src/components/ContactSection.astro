---
import Contact2 from "./starwind-pro/contact-02/Contact2.astro";

---

<section id="contact" class="relative overflow-hidden">
  <div class="absolute inset-0 cyber-grid opacity-20"></div>
  <div class="absolute top-0 left-0 w-96 h-96 bg-neon-cyan/10 rounded-full blur-3xl"></div>

  <div class="relative">
    <Contact2
      badge="Let's chat"
      heading="I'd love to hear from you"
      description="What kind of question do you have for me?"
    />

  </div>
</section>
