---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

import { Button } from "@/components/starwind/button";
import { Card, CardContent } from "@/components/starwind/card";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
import { Textarea } from "@/components/starwind/textarea";

interface Props extends HTMLAttributes<"section"> {
  /** Badge/eyebrow text */
  badge?: string;
  /** Section heading */
  heading?: string;
  /** Section description */
  description?: string;
}

const sectionStyles = tv({
  base: "@container mx-auto w-full max-w-3xl px-4 py-24",
});

const {
  badge = "Contact",
  heading = "Send Us a Message",
  description = "Fill out the form below and we'll get back to you as soon as possible.",
  class: className,
  ...rest
} = Astro.props;
---

<section class={sectionStyles({ class: className })} {...rest}>
  <div class="text-center">
    <span
      class="bg-primary/10 text-primary-accent inline-block rounded-full px-4 py-1.5 text-sm font-medium"
    >
      {badge}
    </span>
    <h2 class="font-heading mt-6 text-3xl font-bold tracking-tight @xl:text-4xl @3xl:text-5xl">
      {heading}
    </h2>
    <p class="text-muted-foreground mx-auto mt-4 max-w-xl text-lg">
      {description}
    </p>
  </div>

  <Card class="mt-10">
    <CardContent>
      <form class="space-y-6" id="contact-form-02" name="contact-form">
        <div class="grid gap-6 @xl:grid-cols-2">
          <div class="flex flex-col gap-1">
            <Label for="contact-name-02">Full Name</Label>
            <Input id="contact-name-02" name="name" type="text" placeholder="Your name" required />
          </div>
          <div class="flex flex-col gap-1">
            <Label for="contact-email-02">Email Address</Label>
            <Input
              id="contact-email-02"
              name="email"
              type="email"
              placeholder="you@example.com"
              required
            />
          </div>
        </div>

        <div class="flex flex-col gap-1">
          <Label for="contact-subject-02">Subject</Label>
          <Input
            id="contact-subject-02"
            name="subject"
            type="text"
            placeholder="What's on your mind?"
            required
          />
        </div>

        <div class="flex flex-col gap-1">
          <Label for="contact-message-02">Message</Label>
          <Textarea
            id="contact-message-02"
            name="message"
            placeholder="Care to elaborate?"
            rows={5}
            required
          />
        </div>

        <!-- Honeypot: hidden from people, tempting to bots -->
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="contact-website-02">Website</label>
          <input
            id="contact-website-02"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <!-- Captcha and submit side by side with equal space around; stacked on narrow screens -->
        <div class="flex flex-col items-center gap-4 @xl:flex-row @xl:justify-around">
          <!-- hCaptcha widget, rendered by the script below -->
          <div id="contact-form-02-captcha" class="min-h-[78px]"></div>

          <!-- Same size as the hCaptcha widget (302x76); ! beats the button's default height -->
          <Button variant="primary" type="submit" class="h-[76px]! w-[302px]! max-w-full text-lg">
            Send Message
          </Button>
        </div>
        <p id="contact-form-02-status" class="text-sm" role="status" aria-live="polite"></p>
      </form>
    </CardContent>
  </Card>

  <p class="text-muted-foreground mt-6 text-center text-sm">
    Expect a reply from me in one to three business days. Thank you for your patience.
  </p>
</section>

<script>
  function handleFormSubmit() {
    const form = document.querySelector<HTMLFormElement>("#contact-form-02");
    if (!form || form.dataset.bound) return;
    form.dataset.bound = "true";

    const status = form.querySelector<HTMLElement>("#contact-form-02-status")!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const submitLabel = submit.textContent;
    const loadedAt = Date.now();

    // Web3Forms has hCaptcha switched on for this form, so every submit needs a
    // token. Free plans must use Web3Forms' shared site key (public by design).
    // The script is injected from JS because this host blanks external URLs in
    // deployed HTML attributes.
    const HCAPTCHA_SITE_KEY = "50b2fe65-b00b-4b9e-ad62-3ba471098be2";
    const captchaEl = form.querySelector<HTMLElement>("#contact-form-02-captcha")!;
    let captchaId: string | undefined;

    function renderCaptcha() {
      const hcaptcha = (window as any).hcaptcha;
      captchaId = hcaptcha.render(captchaEl, { sitekey: HCAPTCHA_SITE_KEY, theme: "dark" });
    }

    if ((window as any).hcaptcha?.render) {
      renderCaptcha();
    } else {
      (window as any).onContactHcaptchaLoad = renderCaptcha;
      const script = document.createElement("script");
      script.src = "https://js.hcaptcha.com/1/api.js?render=explicit&onload=onContactHcaptchaLoad";
      script.async = true;
      script.defer = true;
      document.head.appendChild(script);
    }

    function setStatus(message: string, kind: "success" | "error") {
      status.textContent = message;
      status.classList.toggle("text-success", kind === "success");
      status.classList.toggle("text-red-400", kind === "error");
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const values = Object.fromEntries(new FormData(form).entries());

      // A filled honeypot or an implausibly fast submit means a bot; report
      // success without sending anything.
      if (values.website || Date.now() - loadedAt < 3000) {
        setStatus("Thanks! Your message is on its way.", "success");
        form.reset();
        return;
      }

      const captchaToken: string = (window as any).hcaptcha?.getResponse(captchaId) ?? "";
      if (!captchaToken) {
        setStatus("Please complete the captcha before sending.", "error");
        return;
      }

      submit.disabled = true;
      submit.textContent = "Sending...";
      status.textContent = "";

      try {
        // Web3Forms emails the message to the address the access key was
        // registered with. The key is public by design (it ships in the page).
        const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
        if (!accessKey) throw new Error("PUBLIC_WEB3FORMS_KEY is not set");

        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            access_key: accessKey,
            from_name: "zthedev.com contact form",
            name: values.name,
            email: values.email,
            subject: values.subject,
            message: values.message,
            "h-captcha-response": captchaToken,
          }),
        });
        const result = await response.json().catch(() => null);
        if (!response.ok || !result?.success) {
          throw new Error(`Web3Forms responded ${response.status}: ${result?.message ?? "no body"}`);
        }
        form.reset();
        window.location.assign("/thank-you");
        return;
      } catch (error) {
        console.error("Contact form submission failed:", error);
        // Tokens are single-use, so a retry needs a fresh challenge.
        (window as any).hcaptcha?.reset(captchaId);
        setStatus("Something went wrong sending your message. Please try again in a moment.", "error");
      } finally {
        submit.disabled = false;
        submit.textContent = submitLabel;
      }
    });
  }

  handleFormSubmit();

  document.addEventListener("astro:after-swap", handleFormSubmit);
</script>
